SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./flowcard.db

# AI — Gemini 1.5 Flash (best quality vision). Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Groq (free tier fallback). Get key: https://console.groq.com
GROQ_API_KEY=

# Ollama — runs locally, free. Install: https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# How many cards to generate per image
CARD_COUNT=10

# Where uploaded images are stored
UPLOAD_DIR=uploads
